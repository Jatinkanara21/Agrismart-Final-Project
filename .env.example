# Server-Side Ollama Cloud Configuration (NEVER prefix with VITE_)
# Leave OLLAMA_API_KEY empty to run in transparent DEMO Advisory Mode.
OLLAMA_BASE_URL="https://ollama.com"
OLLAMA_API_KEY=""
OLLAMA_TEXT_MODEL="qwen2.5"
OLLAMA_VISION_MODEL="llama3.2-vision"
OLLAMA_TIMEOUT_MS="28000"

# Live Weather Configuration (Open-Meteo requires no API key)
OPEN_METEO_TIMEOUT_MS="10000"

# Application Port & URL
PORT="3000"
APP_URL="http://localhost:3000"

# Optional: Gemini API Key (injected automatically by AI Studio if needed)
GEMINI_API_KEY=""
